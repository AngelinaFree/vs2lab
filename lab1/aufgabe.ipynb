   "source": [
    "import os\n",
    "import aufgabe1\n",
    "\n",
    "server = aufgabe1.Server()\n",
    "pid = os.fork()\n",
    "\n",
    "if pid == 0:\n",
    "    try:\n",
    "        server.serve()\n",
    "    finally:\n",
    "        os._exit(0)"
   ]
